-- RIVALS - AUTO COLLECT ALL JUMP SHARDS (Lobby + Every Map) - FIXED & WORKING 2025
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- Wait for character properly
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

local collected = 0
local shards = {}

print("Scanning for Jump Shards...")

-- METHOD 1: ProximityPrompt (most reliable — this is how the game does it)
for _, obj in ipairs(Workspace:GetDescendants()) do
    if obj:IsA("ProximityPrompt") then
        local text = obj.ActionText or ""
        if string.find(string.lower(text), "collect") or string.find(string.lower(text), "shard") then
            local part = obj.Parent
            if part and (part:IsA("BasePart") or part:IsA("MeshPart")) then
                table.insert(shards, part)
                print("Found shard (Prompt):", part:GetFullName(), part.Position)
            end
        end
    end
end

-- METHOD 2: Fallback by name (in case prompts are missing or changed)
if #shards == 0 then
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("MeshPart")) and 
           string.find(string.lower(obj.Name), "jumpshard") then
            table.insert(shards, obj)
            print("Found shard (Name fallback):", obj.Name, obj.Position)
        end
    end
end

if #shards == 0 then
    warn("No Jump Shards found! Are you in the lobby or a match?")
    return
end

print("Found", #shards, "Jump Shard(s)! Starting collection...")

-- Fast & Safe Collection
for _, shard in ipairs(shards) do
    if shard and shard.Parent then
        -- Teleport directly on top
        HumanoidRootPart.CFrame = shard.CFrame + Vector3.new(0, 4, 0)
        task.wait(0.12) -- Perfect delay — too fast = server ignores, too slow = slow
        collected = collected + 1
    end
end

-- Final Notification
game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "Jump Shards Collected!",
    Text = "Successfully grabbed " .. collected .. "/9 shards!",
    Icon = "rbxassetid://6034834007",
    Duration = 6
})

print("Done! Collected", collected, "Jump Shards. Run again on next map!")
